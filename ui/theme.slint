/// A dark/light palette that follows the chosen theme. `System` leaves the
/// platform-provided scheme in place; Light/Dark override the app colours and
/// the native widget palette.
export global AppPalette {
    in-out property <bool> dark: false;

    in-out property <color> window-bg: root.dark ? #202124 : #f2f2f2;
    in-out property <color> header-bg: root.dark ? #292a2d : #e6e6e6;
    in-out property <color> panel-bg: root.dark ? #2a2b2e : #e9e9e9;
    in-out property <color> field-bg: root.dark ? #35363a : #ffffff;
    in-out property <color> button-bg: root.dark ? #3c4043 : #fafafa;
    in-out property <color> border: root.dark ? #5f6368 : #b9b9b9;
    in-out property <color> button-border: root.dark ? #6b7076 : #adadad;
    in-out property <color> panel-border: root.dark ? #414347 : #d2d2d2;
    in-out property <color> text: root.dark ? #e8eaed : #1f1f1f;
    in-out property <color> text-dim: root.dark ? #9aa0a6 : #6a6a6a;
    in-out property <color> placeholder: root.dark ? #7c8085 : #9a9a9a;
    in-out property <color> primary: root.dark ? #8ab4f8 : #2f6fdb;
    in-out property <color> primary-dark: root.dark ? #aecbfa : #2b548a;
    in-out property <color> selection: root.dark ? #3c4043 : #e3ebf4;
    in-out property <color> gray: #8a8a8a;
    in-out property <color> amber: #c8871a;
    in-out property <color> green: #2e8b3d;
    in-out property <color> red: #c0392b;
    in-out property <color> error-bg: root.dark ? #3c2523 : #f9e9e7;
    in-out property <color> error-border: root.dark ? #8c4a43 : #e0b4b0;
    in-out property <color> error-text: root.dark ? #f3b4ae : #8c2f24;
}

export component StatusDot inherits Rectangle {
    in-out property <color> dot-color: AppPalette.gray;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #40000000;
    background: root.dot-color;
}

export component PrimaryButton inherits Rectangle {
    in-out property <bool> emphasized: false;
    in-out property <string> text;
    callback clicked();
    min-height: 38px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.emphasized ? AppPalette.primary-dark : AppPalette.button-border;
    background: root.emphasized ? AppPalette.primary : AppPalette.button-bg;
    Text { text: root.text; color: root.emphasized ? #ffffff : AppPalette.text; font-size: 15px; font-weight: root.emphasized ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

export component SmallButton inherits Rectangle {
    in-out property <string> text;
    in-out property <bool> selected: false;
    in-out property <bool> highlighted: false;
    callback clicked();
    min-height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: AppPalette.button-border;
    background: root.highlighted ? AppPalette.primary : (root.selected ? AppPalette.selection : AppPalette.button-bg);
    Text { text: root.text; color: root.highlighted ? #ffffff : AppPalette.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

export component FieldLabel inherits Text {
    color: AppPalette.text-dim;
    font-size: 12px;
}

export component SectionTitle inherits Text {
    color: AppPalette.text-dim;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.6px;
}
