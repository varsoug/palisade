import { Button } from "std-widgets.slint";

export global Palette {
    out property <color> window-bg: #f2f2f2;
    out property <color> header-bg: #e6e6e6;
    out property <color> panel-bg: #e9e9e9;
    out property <color> field-bg: #ffffff;
    out property <color> button-bg: #fafafa;
    out property <color> border: #b9b9b9;
    out property <color> button-border: #adadad;
    out property <color> panel-border: #d2d2d2;
    out property <color> text: #1f1f1f;
    out property <color> text-dim: #6a6a6a;
    out property <color> placeholder: #9a9a9a;
    out property <color> primary: #2f6fdb;
    out property <color> primary-dark: #2b548a;
    out property <color> selection: #e3ebf4;
    out property <color> gray: #8a8a8a;
    out property <color> amber: #c8871a;
    out property <color> green: #2e8b3d;
    out property <color> red: #c0392b;
    out property <color> error-bg: #f9e9e7;
    out property <color> error-border: #e0b4b0;
    out property <color> error-text: #8c2f24;
}

export component StatusDot inherits Rectangle {
    in property <color> dot-color: Palette.gray;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #40000000;
    background: root.dot-color;
}

export component PrimaryButton inherits Rectangle {
    in property <bool> emphasized: false;
    in property <string> text;
    callback clicked();
    min-height: 38px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.emphasized ? Palette.primary-dark : Palette.button-border;
    background: root.emphasized ? Palette.primary : Palette.button-bg;
    Text { text: root.text; color: root.emphasized ? #ffffff : Palette.text; font-size: 15px; font-weight: root.emphasized ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

export component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> highlighted: false;
    callback clicked();
    min-height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.button-border;
    background: root.highlighted ? Palette.primary : (root.selected ? Palette.selection : Palette.button-bg);
    Text { text: root.text; color: root.highlighted ? #ffffff : Palette.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

export component FieldLabel inherits Text {
    color: Palette.text-dim;
    font-size: 12px;
}

export component SectionTitle inherits Text {
    color: Palette.text-dim;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.6px;
}
